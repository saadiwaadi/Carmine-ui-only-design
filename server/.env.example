# Copy this file to .env and fill in real values. Never commit the real .env file.

# Postgres connection string for your online database (Neon, Supabase, Railway, Render, etc.)
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="file:./dev.db"

# Secret used to sign admin JWT sessions. Use a long random string.
JWT_SECRET="carmine-local-secret-change-in-production"

# Seed credentials for the first admin account (used only by `npm run seed`).
ADMIN_EMAIL="admin@carmine.local"
ADMIN_PASSWORD="admin123"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (frontend URL(s)).
CORS_ORIGIN="http://localhost:4000"
